<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    DirectoryIndex index.html index.php

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1) HTTP -> HTTPS (production domain only)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^ciptacoding\.com$ [NC]
    RewriteRule ^(.*)$ https://ciptacoding.com/$1 [R=301,L]

    # 2) www.ciptacoding.com -> ciptacoding.com
    RewriteCond %{HTTP_HOST} ^www\.ciptacoding\.com$ [NC]
    RewriteRule ^(.*)$ https://ciptacoding.com/$1 [R=301,L]

    # 3) Send Virtual Requests To Laravel Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
